# ═══════════════════════════════════════════════════════════════════════════════
# EMPIRIA — Variables de Entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env a Git.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Entorno ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
# Opción A: URL completa (Railway la provee automáticamente como DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/database

# Opción B: Variables individuales (desarrollo local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=empiria_db
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 64
# CAMBIAR en producción — nunca usar el valor de desarrollo
JWT_SECRET=GENERA_CON__openssl_rand_base64_64__Y_REEMPLAZA_ESTO
JWT_EXPIRES_IN=8h

# ── Cloudflare R2 (almacenamiento de archivos) ────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=empiria-documents
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL(s) del frontend en producción. Múltiples separadas por coma.
# Ejemplo: https://mi-app.up.railway.app,https://mi-dominio.com
CORS_ORIGIN=https://tu-proyecto.up.railway.app

# ── Seguridad adicional ────────────────────────────────────────────────────────
# Deshabilitar endpoints de demo en producción (recomendado)
DISABLE_DEMO_ENDPOINTS=true
